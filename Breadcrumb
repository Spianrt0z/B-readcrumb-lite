local D = Drawing
local V2 = Vector2.new
local function mk(t)
    if not D then return nil end
    local ok, o = pcall(D.new, t)
    if not ok or not o then return nil end
    o.Visible = false
    return o
end
local function set(o, k, v) if o then pcall(function() o[k] = v end) end end

