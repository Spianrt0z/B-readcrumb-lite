-- ============================================================
-- ESP RENDER
-- ============================================================
local draws = {}
local function get_draws(plr)
    if draws[plr] then return draws[plr] end
    local d = { box=mk("Square"), name=mk("Text"), tracer=mk("Line"), dist=mk("Text") }
    if d.name then set(d.name, "Size", 14); set(d.name, "Center", true); set(d.name, "Outline", true) end
    if d.dist then set(d.dist, "Size", 12); set(d.dist, "Center", true); set(d.dist, "Outline", true) end
    draws[plr] = d
    return d
end
local function hide_all(d) if d then for _, o in pairs(d) do set(o, "Visible", false) end end end

local function w2s(world)
    local ok, s, on = pcall(function() return Camera:WorldToScreenPoint(world) end)
    if not ok or not on then return nil end
    return V2(s.X, s.Y)
end

local function update_esp()
    if not Drawing then return end
    if not S.esp then for _, d in pairs(draws) do hide_all(d) end return end
    local vp = Camera.ViewportSize
    local origin = V2(vp.X * 0.5, vp.Y)
    local cam_pos = Camera.CFrame.Position
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then
            local d = get_draws(plr)
            local ch = plr.Character
            local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
            local head = ch and ch:FindFirstChild("Head")
            local esp_friendly = S.esp_team and LP.Team and plr.Team and plr.Team == LP.Team
            local show = ch and hrp and head and not esp_friendly
            if show then
                local dist = (hrp.Position - cam_pos).Magnitude
                if dist > S.esp_dist then show = false end
            end
            if not show or not d then
                hide_all(d)
            else
                local top  = w2s(head.Position + Vector3.new(0, head.Size.Y * 0.5, 0))
                local feet = w2s(hrp.Position - Vector3.new(0, 3, 0))
                if not top or not feet then
                    hide_all(d)
                else
                    local h = feet.Y - top.Y
                    if h < 2 then
                        hide_all(d)
                    else
                        local w = h * 0.55
                        if S.esp_box and d.box then
                            set(d.box, "Visible", true) set(d.box, "Size", V2(w, h))
                            set(d.box, "Position", V2(top.X - w * 0.5, top.Y))
                            set(d.box, "Color", Color3.fromRGB(180, 210, 255))
                            set(d.box, "Thickness", 1) set(d.box, "Filled", false)
                        end
                        if S.esp_name and d.name then
                            set(d.name, "Visible", true) set(d.name, "Text", plr.Name)
                            set(d.name, "Color", Color3.fromRGB(235, 235, 255))
                            set(d.name, "Position", V2(top.X, top.Y - 16))
                        end
                        if d.dist then
                            set(d.dist, "Visible", true)
                            set(d.dist, "Text", ("%d"):format(math.floor((hrp.Position - cam_pos).Magnitude)))
                            set(d.dist, "Color", Color3.fromRGB(200, 200, 200))
                            set(d.dist, "Position", V2(top.X, feet.Y + 4))
                        end
                        if S.esp_tracer and d.tracer then
                            set(d.tracer, "Visible", true)
                            set(d.tracer, "Color", Color3.fromRGB(160, 200, 255))
                            local ok1 = pcall(function() d.tracer.From = origin end)
                            if not ok1 then pcall(function() d.tracer.PointA = origin end) end
                            local ok2 = pcall(function() d.tracer.To = V2(top.X, feet.Y) end)
                            if not ok2 then pcall(function() d.tracer.PointB = V2(top.X, feet.Y) end) end
                        end
                    end
                end
            end
        end
    end
end

-- ============================================================
-- AIMBOT
-- ============================================================
local function in_fov(sp, fov)
    if not sp then return false end
    local vp = Camera.ViewportSize
    local c = V2(vp.X * 0.5, vp.Y * 0.5)
    local off = sp - c
    return math.deg(math.atan(off.Magnitude / (vp.Y * 0.5))) <= fov
end

local function pick()
    local best, bd = nil, math.huge
    local vp = Camera.ViewportSize
    local c = V2(vp.X * 0.5, vp.Y * 0.5)
    for _, plr in ipairs(Players:GetPlayers()) do
        if is_targetable(plr) then
            local ch = plr.Character
            local bone = ch and ch:FindFirstChild(S.aim_bone)
            if bone then
                local sp_ = w2s(bone.Position)
                if sp_ and in_fov(sp_, S.aim_fov) then
                    local d = (sp_ - c).Magnitude
                    if d < bd then bd = d; best = { pos = bone.Position } end
                end
            end
        end
    end
    return best
end

local function run_aim()
    if not S.aim then return end
    if not UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then return end
    local t = pick()
    if not t then return end
    local cam = Camera.CFrame
    local want = CFrame.new(cam.Position, t.pos)
    Camera.CFrame = cam:Lerp(want, 1 / math.max(S.aim_smooth, 1))
end

-- ============================================================
-- MOVEMENT HACKS
-- ============================================================
local fly_bv, fly_bg
local function start_fly()
    local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    if fly_bv then fly_bv:Destroy() end
    if fly_bg then fly_bg:Destroy() end
    fly_bv = Instance.new("BodyVelocity", hrp)
    fly_bv.Name = "bc_fly"
    fly_bv.MaxForce = Vector3.new(1e6,1e6,1e6)
    fly_bv.Velocity = Vector3.zero
    fly_bg = Instance.new("BodyGyro", hrp)
    fly_bg.Name = "bc_fly"
    fly_bg.MaxTorque = Vector3.new(1e6,1e6,1e6)
    fly_bg.P = 1500; fly_bg.D = 50
    fly_bg.CFrame = hrp.CFrame
end
local function stop_fly()
    if fly_bv then fly_bv:Destroy() fly_bv = nil end
    if fly_bg then fly_bg:Destroy() fly_bg = nil end
end

local last_jump = 0
local function movement_tick()
    local ch = LP.Character
    local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
    local hum = ch and ch:FindFirstChildOfClass("Humanoid")

    if S.walk and hum then hum.WalkSpeed = S.walk_speed end
    if S.jump and hum then
        hum.UseJumpPower = true
        hum.JumpPower = S.jump_power
    end

    -- infinite jump
    if S.inf_jump and hum and hrp then
        local state = hum:GetState()
        if state == Enum.HumanoidStateType.Freefall or state == Enum.HumanoidStateType.Jumping then
            if UIS:IsKeyDown(Enum.KeyCode.Space) and tick() - last_jump > 0.15 then
                last_jump = tick()
                hum:ChangeState(Enum.HumanoidStateType.Jumping)
                pcall(function() hrp.Velocity = Vector3.new(hrp.Velocity.X, S.jump_power * 0.8, hrp.Velocity.Z) end)
            end
        end
    end

    -- fly
    if S.fly then
        if not fly_bv then start_fly() end
        if fly_bv and fly_bg and hrp then
            local cf = Camera.CFrame
            local mv = Vector3.zero
            if UIS:IsKeyDown(Enum.KeyCode.W) then mv += cf.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.S) then mv -= cf.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.A) then mv -= cf.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.D) then mv += cf.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.Space) then mv += Vector3.new(0,1,0) end
            if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then mv -= Vector3.new(0,1,0) end
            if mv.Magnitude > 0 then mv = mv.Unit * S.fly_speed end
            fly_bv.Velocity = mv
            fly_bg.CFrame = CFrame.new(Vector3.zero) * cf.Rotation
        end
    else
        if fly_bv then stop_fly() end
    end

    -- noclip
    if S.noclip and ch then
        for _, p in ipairs(ch:GetDescendants()) do
            if p:IsA("BasePart") and p.CanCollide then p.CanCollide = false end
        end
    end
end

-- ============================================================
-- HITBOX EXPANDER
-- ============================================================
local original_sizes = {}
local function hitbox_tick()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then
            local ch = plr.Character
            if ch then
                for _, part in ipairs(ch:GetDescendants()) do
                    if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                        if S.hitbox then
                            if not original_sizes[part] then
                                original_sizes[part] = part.Size
                            end
                            part.Size = original_sizes[part] * S.hitbox_size
                            part.Transparency = 0.5
                        else
                            if original_sizes[part] then
                                part.Size = original_sizes[part]
                                part.Transparency = 0
                                original_sizes[part] = nil
                            end
                        end
                    end
                end
            end
        end
    end
end

