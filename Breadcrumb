-- ============================================================
-- TARGET FILTER
-- ============================================================
local function is_friendly(plr)
    if plr == LP then return true end
    if S.aim_team and LP.Team and plr.Team and plr.Team == LP.Team then return true end
    return false
end
local function is_dead(plr)
    if not S.aim_dead then return false end
    local ch = plr.Character
    if not ch then return true end
    local hum = ch:FindFirstChildOfClass("Humanoid")
    if not hum then return true end
    return hum.Health <= 0
end
local function has_forcefield(plr)
    if not S.aim_ff then return false end
    local ch = plr.Character
    if not ch then return false end
    return ch:FindFirstChildOfClass("ForceField") ~= nil
end
local function is_targetable(plr)
    if plr == LP then return false end
    if is_friendly(plr) then return false end
    if is_dead(plr) then return false end
    if has_forcefield(plr) then return false end
    return true
end

