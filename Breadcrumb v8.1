local function slider(page, text, min, max, step, get, set_)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, 0, 0, 46)
    row.BackgroundColor3 = CARD
    row.BorderSizePixel = 0
    row.Parent = page
    round(row, 8)
    strk(row, Color3.fromRGB(45, 52, 68), 1)

    local t = Instance.new("TextLabel")
    t.Size = UDim2.new(1, -100, 0, 18)
    t.Position = UDim2.new(0, 14, 0, 4)
    t.BackgroundTransparency = 1
    t.Font = Enum.Font.Gotham
    t.Text = text
    t.TextSize = 12
    t.TextColor3 = TXT
    t.TextXAlignment = Enum.TextXAlignment.Left
    t.Parent = row

    local val = Instance.new("TextLabel")
    val.Size = UDim2.new(0, 70, 0, 18)
    val.Position = UDim2.new(1, -84, 0, 4)
    val.BackgroundTransparency = 1
    val.Font = Enum.Font.GothamBold
    val.TextSize = 12
    val.TextColor3 = ACCENT
    val.TextXAlignment = Enum.TextXAlignment.Right
    val.Text = tostring(get())
    val.Parent = row

    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(1, -28, 0, 6)
    bar.Position = UDim2.new(0, 14, 0, 30)
    bar.BackgroundColor3 = Color3.fromRGB(40, 46, 60)
    bar.BorderSizePixel = 0
    bar.Parent = row
    round(bar, 3)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(0, 0, 1, 0)
    fill.BackgroundColor3 = ACCENT
    fill.BorderSizePixel = 0
    fill.Parent = bar
    round(fill, 3)
    grad(fill, ACCENT, ACCENT2, 0)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 12, 0, 12)
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.Position = UDim2.new(0, 0, 0.5, 0)
    knob.BackgroundColor3 = Color3.fromRGB(255,255,255)
    knob.BorderSizePixel = 0
    knob.ZIndex = 3
    knob.Parent = bar
    round(knob, 6)

    local dragging = false
    local function apply(x)
        local rel = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        local v = min + (max - min) * rel
        v = math.floor(v / step + 0.5) * step
        fill.Size = UDim2.new(rel, 0, 1, 0)
        knob.Position = UDim2.new(rel, 0, 0.5, 0)
        val.Text = tostring(v)
        set_(v)
    end

    bar.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            _any_slider_dragging = true
            win.Draggable = false
            apply(i.Position.X)
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
            apply(i.Position.X)
        end
    end)
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 and dragging then
            dragging = false
            _any_slider_dragging = false
            win.Draggable = true
        end
    end)

    local cur = math.clamp((get() - min) / (max - min), 0, 1)
    fill.Size = UDim2.new(cur, 0, 1, 0)
    knob.Position = UDim2.new(cur, 0, 0.5, 0)
end

