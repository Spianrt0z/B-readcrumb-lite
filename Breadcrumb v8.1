section(pC, "Info")
local info = Instance.new("TextLabel")
info.Size = UDim2.new(1, 0, 0, 90)
info.BackgroundColor3 = CARD
info.BorderSizePixel = 0
info.Font = Enum.Font.Gotham
info.Text = "breadcrumb v8.1\nToggle: Right Shift\nPanic: End (rebindable)"
info.TextSize = 11
info.TextColor3 = TXT_DIM
info.TextYAlignment = Enum.TextYAlignment.Top
info.TextWrapped = true
info.Parent = pC
round(info, 8)
local pad = Instance.new("UIPadding", info)
pad.PaddingTop = UDim.new(0, 10)
pad.PaddingLeft = UDim.new(0, 12)
pad.PaddingRight = UDim.new(0, 12)

local draws = {}
local function get_draws(plr)
    if draws[plr] then return draws[plr] end
    local d = { box=mk("Square"), name=mk("Text"), tracer=mk("Line"), dist=mk("Text") }
    if d.name then sset(d.name, "Size", 14); sset(d.name, "Center", true); sset(d.name, "Outline", true) end
    if d.dist then sset(d.dist, "Size", 12); sset(d.dist, "Center", true); sset(d.dist, "Outline", true) end
    draws[plr] = d
    return d
end
local function hide(d) if d then for _, o in pairs(d) do sset(o, "Visible", false) end end end

local function w2s(world)
    local ok, s, on = pcall(function() return Camera:WorldToScreenPoint(world) end)
    if not ok or not on then return nil end
    return V2(s.X, s.Y)
end

local function update_esp()
    if not Drawing then return end
    if not S.esp.on then for _, d in pairs(draws) do hide(d) end return end
    local vp = Camera.ViewportSize
    local origin = V2(vp.X * 0.5, vp.Y)
    local cam_pos = Camera.CFrame.Position
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then
            local d = get_draws(plr)
            local ch = plr.Character
            local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
            local head = ch and ch:FindFirstChild("Head")
            local friendly = S.esp.team and LP.Team and plr.Team and plr.Team == LP.Team
            local show = ch and hrp and head and not friendly
            local dist = 0
            if show then
                dist = (hrp.Position - cam_pos).Magnitude
                if dist > S.esp.max then show = false end
            end
            if not show or not d then
                hide(d)
            else
                local top  = w2s(head.Position + Vector3.new(0, head.Size.Y * 0.5, 0))
                local feet = w2s(hrp.Position - Vector3.new(0, 3, 0))
                if not top or not feet then
                    hide(d)
                else
                    local h = feet.Y - top.Y
                    if h < 2 then
                        hide(d)
                    else
                        local w = h * 0.55
                        if S.esp.box and d.box then
                            sset(d.box, "Visible", true)
                            sset(d.box, "Size", V2(w, h))
                            sset(d.box, "Position", V2(top.X - w * 0.5, top.Y))
                            sset(d.box, "Color", Color3.fromRGB(180, 210, 255))
                            sset(d.box, "Thickness", 1)
                            sset(d.box, "Filled", false)
                        else
                            sset(d.box, "Visible", false)
                        end
                        if S.esp.name and d.name then
                            sset(d.name, "Visible", true)
                            sset(d.name, "Text", plr.Name)
                            sset(d.name, "Color", Color3.fromRGB(235, 235, 255))
                            sset(d.name, "Position", V2(top.X, top.Y - 16))
                        else
                            sset(d.name, "Visible", false)
                        end
                        if S.esp.dist and d.dist then
                            sset(d.dist, "Visible", true)
                            sset(d.dist, "Text", ("%d"):format(math.floor(dist)))
                            sset(d.dist, "Color", Color3.fromRGB(200, 200, 200))
                            sset(d.dist, "Position", V2(top.X, feet.Y + 4))
                        else
                            sset(d.dist, "Visible", false)
                        end
                        if S.esp.tracer and d.tracer then
                            sset(d.tracer, "Visible", true)
                            sset(d.tracer, "Color", Color3.fromRGB(160, 200, 255))
                            local ok1 = pcall(function() d.tracer.From = origin end)
                            if not ok1 then pcall(function() d.tracer.PointA = origin end) end
                            local ok2 = pcall(function() d.tracer.To = V2(top.X, feet.Y) end)
                            if not ok2 then pcall(function() d.tracer.PointB = V2(top.X, feet.Y) end) end
                        else
                            sset(d.tracer, "Visible", false)
                        end
                    end
                end
            end
        end
    end
end

local function in_fov(sp, fov)
    if not sp then return false end
    local vp = Camera.ViewportSize
    local c = V2(vp.X * 0.5, vp.Y * 0.5)
    local off = sp - c
    return math.deg(math.atan(off.Magnitude / (vp.Y * 0.5))) <= fov
end

local function hold_check()
    local h = S.aim.hold
    if h == "MouseButton1" then return UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) end
    if h == "MouseButton2" then return UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) end
    if h == "LeftAlt" then return UIS:IsKeyDown(Enum.KeyCode.LeftAlt) end
    if h == "LeftShift" then return UIS:IsKeyDown(Enum.KeyCode.LeftShift) end
    if h == "Q" then return UIS:IsKeyDown(Enum.KeyCode.Q) end
    return false
end

local function pick()
    local best, bd = nil, math.huge
    local vp = Camera.ViewportSize
    local c = V2(vp.X * 0.5, vp.Y * 0.5)
    for _, plr in ipairs(Players:GetPlayers()) do
        if targetable(plr) then
            local ch = plr.Character
            local bone = ch and ch:FindFirstChild(S.aim.bone)
            if bone then
                local sp_ = w2s(bone.Position)
                if sp_ and in_fov(sp_, S.aim.fov) then
                    local d = (sp_ - c).Magnitude
                    if d < bd then bd = d; best = { pos = bone.Position } end
                end
            end
        end
    end
    return best
end

local function run_aim()
    if not S.aim.on then return end
    if not hold_check() then return end
    local t = pick()
    if not t then return end
    local cam = Camera.CFrame
    local want = CFrame.new(cam.Position, t.pos)
    Camera.CFrame = cam:Lerp(want, 1 / math.max(S.aim.smooth, 1))
end

local fly_bv, fly_bg
local function start_fly()
    local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    if fly_bv then fly_bv:Destroy() end
    if fly_bg then fly_bg:Destroy() end
    fly_bv = Instance.new("BodyVelocity", hrp)
    fly_bv.Name = "bc_fly"
    fly_bv.MaxForce = Vector3.new(1e6,1e6,1e6)
    fly_bv.Velocity = Vector3.zero
    fly_bg = Instance.new("BodyGyro", hrp)
    fly_bg.Name = "bc_fly"
    fly_bg.MaxTorque = Vector3.new(1e6,1e6,1e6)
    fly_bg.P = 1500; fly_bg.D = 50
    fly_bg.CFrame = hrp.CFrame
end
local function stop_fly()
    if fly_bv then fly_bv:Destroy() fly_bv = nil end
    if fly_bg then fly_bg:Destroy() fly_bg = nil end
end

local last_jump = 0
local function movement_tick()
    local ch = LP.Character
    local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
    local hum = ch and ch:FindFirstChildOfClass("Humanoid")

    if hum then
        if S.move.speed_on then
            hum.WalkSpeed = S.move.speed
            _speed_was_on = true
        elseif _speed_was_on then
            hum.WalkSpeed = 16
            _speed_was_on = false
        end
        if S.move.jump_on then
            hum.UseJumpPower = true
            hum.JumpPower = S.move.jump
            _jump_was_on = true
        elseif _jump_was_on then
            hum.JumpPower = 50
            _jump_was_on = false
        end
    end

    if S.move.inf_jump and hum and hrp then
        local state = hum:GetState()
        if state == Enum.HumanoidStateType.Freefall or state == Enum.HumanoidStateType.Jumping then
            if UIS:IsKeyDown(Enum.KeyCode.Space) and tick() - last_jump > 0.15 then
                last_jump = tick()
                hum:ChangeState(Enum.HumanoidStateType.Jumping)
                pcall(function() hrp.Velocity = Vector3.new(hrp.Velocity.X, S.move.jump * 0.8, hrp.Velocity.Z) end)
            end
        end
    end

    if S.move.fly then
        if not fly_bv then start_fly() end
        if fly_bv and fly_bg and hrp then
            local cf = Camera.CFrame
            local mv = Vector3.zero
            if UIS:IsKeyDown(Enum.KeyCode.W) then mv += cf.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.S) then mv -= cf.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.A) then mv -= cf.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.D) then mv += cf.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.Space) then mv += Vector3.new(0,1,0) end
            if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then mv -= Vector3.new(0,1,0) end
            if mv.Magnitude > 0 then mv = mv.Unit * S.move.fly_speed end
            fly_bv.Velocity = mv
            fly_bg.CFrame = CFrame.new(Vector3.zero) * cf.Rotation
        end
    else
        if fly_bv then stop_fly() end
    end

    if S.move.noclip and ch then
        for _, p in ipairs(ch:GetDescendants()) do
            if p:IsA("BasePart") and p.CanCollide then
                p.CanCollide = false
                _noclip_parts[p] = true
            end
        end
    elseif next(_noclip_parts) then
        for part, _ in pairs(_noclip_parts) do
            if part and part.Parent and part:IsA("BasePart") then
                part.CanCollide = true
            end
        end
        _noclip_parts = {}
    end
end

local orig_sizes = {}
local function hitbox_tick()
    for part in pairs(orig_sizes) do
        if not part or not part.Parent then orig_sizes[part] = nil end
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then
            local ch = plr.Character
            if ch then
                for _, part in ipairs(ch:GetDescendants()) do
                    if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                        if S.rage.hitbox then
                            if not orig_sizes[part] then orig_sizes[part] = part.Size end
                            part.Size = orig_sizes[part] * S.rage.hitbox_size
                            part.Transparency = 0.5
                        elseif orig_sizes[part] then
                            pcall(function()
                                part.Size = orig_sizes[part]
                                part.Transparency = 0
                            end)
                            orig_sizes[part] = nil
                        end
                    end
                end
            end
        end
    end
end

RunService.RenderStepped:Connect(function()
    pcall(update_esp)
    pcall(run_aim)
    pcall(movement_tick)
    pcall(hitbox_tick)
end)

LP.CharacterAdded:Connect(function()
    stop_fly()
    orig_sizes = {}
    _noclip_parts = {}
    _speed_was_on = false
    _jump_was_on = false
end)

local function toggleMenu()
    win.Visible = not win.Visible
end

fab.MouseButton1Click:Connect(toggleMenu)
closeBtn.MouseButton1Click:Connect(function() win.Visible = false end)

UIS.InputBegan:Connect(function(input, gp)
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
    for action, key in pairs(BINDS) do
        if key and input.KeyCode == key then
            if action == "toggle_menu" then
                toggleMenu()
            elseif ACTIONS[action] then
                ACTIONS[action]()
            end
        end
    end
end)

