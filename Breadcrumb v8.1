    t.BackgroundTransparency = 1
    t.Font = Enum.Font.Gotham
    t.Text = text
    t.TextSize = 13
    t.TextColor3 = TXT
    t.TextXAlignment = Enum.TextXAlignment.Left
    t.Parent = row

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 100, 0, 24)
    btn.Position = UDim2.new(1, -112, 0.5, -12)
    btn.BackgroundColor3 = Color3.fromRGB(45, 52, 68)
    btn.BorderSizePixel = 0
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 12
    btn.TextColor3 = ACCENT
    btn.Text = tostring(get())
    btn.Parent = row
    round(btn, 6)
    btn.MouseButton1Click:Connect(function()
        local cur = get(); local idx = 1
        for i, o in ipairs(opts) do if o == cur then idx = i break end end
        idx = (idx % #opts) + 1
        set_(opts[idx]); btn.Text = tostring(opts[idx])
    end)
end

local function keybindRow(page, label, action)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, 0, 0, 34)
    row.BackgroundColor3 = CARD
    row.BorderSizePixel = 0
    row.Parent = page
    round(row, 8)
    strk(row, Color3.fromRGB(45, 52, 68), 1)

    local t = Instance.new("TextLabel")
    t.Size = UDim2.new(1, -140, 1, 0)
    t.Position = UDim2.new(0, 14, 0, 0)
    t.BackgroundTransparency = 1
    t.Font = Enum.Font.Gotham
    t.Text = label
    t.TextSize = 13
    t.TextColor3 = TXT
    t.TextXAlignment = Enum.TextXAlignment.Left
    t.Parent = row

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 110, 0, 24)
    btn.Position = UDim2.new(1, -122, 0.5, -12)
    btn.BackgroundColor3 = Color3.fromRGB(45, 52, 68)
    btn.BorderSizePixel = 0
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 11
    btn.TextColor3 = ACCENT
    btn.Text = BINDS[action] and BINDS[action].Name or "unbound"
    btn.Parent = row
    round(btn, 6)

    local listening = false
    local conn
    btn.MouseButton1Click:Connect(function()
        if listening then
            listening = false
            if conn then conn:Disconnect(); conn = nil end
            btn.Text = BINDS[action] and BINDS[action].Name or "unbound"
            btn.TextColor3 = ACCENT
            return
        end
        listening = true
        btn.Text = "press a key..."
        btn.TextColor3 = Color3.fromRGB(255, 200, 100)
        conn = UIS.InputBegan:Connect(function(input, gp)
            if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
            if input.KeyCode == Enum.KeyCode.Escape then
                BINDS[action] = nil
            else
                BINDS[action] = input.KeyCode
            end
            listening = false
            if conn then conn:Disconnect(); conn = nil end
            btn.Text = BINDS[action] and BINDS[action].Name or "unbound"
            btn.TextColor3 = ACCENT
        end)
    end)
end

