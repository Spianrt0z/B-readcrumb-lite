local function is_friendly(plr)
    if plr == LP then return true end
    if S.aim.team and LP.Team and plr.Team and plr.Team == LP.Team then return true end
    return false
end
local function is_dead(plr)
    if not S.aim.dead then return false end
    local ch = plr.Character
    if not ch then return true end
    local hum = ch:FindFirstChildOfClass("Humanoid")
    return hum == nil or hum.Health <= 0
end
local function has_ff(plr)
    if not S.aim.ff then return false end
    local ch = plr.Character
    if not ch then return false end
    return ch:FindFirstChildOfClass("ForceField") ~= nil
end
local function targetable(plr)
    if plr == LP then return false end
    if is_friendly(plr) then return false end
    if is_dead(plr) then return false end
    if has_ff(plr) then return false end
    return true
end

local D = Drawing
local V2 = Vector2.new
local function mk(t)
    if not D then return nil end
    local ok, o = pcall(D.new, t)
    if not ok or not o then return nil end
    o.Visible = false
    return o
end
local function sset(o,k,v) if o then pcall(function() o[k]=v end) end end

